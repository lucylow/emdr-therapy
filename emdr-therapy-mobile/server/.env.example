# Copy to server/.env only for local development. Never commit real secrets.
NODE_ENV=production
PORT=3000

# Authentication service and session signing
VITE_APP_ID=replace-with-the-registered-app-id
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=mysql://username:password@host:3306/database
OAUTH_SERVER_URL=https://oauth.example.com

# Comma-separated exact origins and callback URIs. Do not use wildcards.
CORS_ALLOWED_ORIGINS=https://app.example.com
OAUTH_REDIRECT_URIS=emdrflow:///oauth/callback,https://app.example.com/api/oauth/callback

# Optional. Omit for host-only cookies.
SESSION_COOKIE_DOMAIN=

# Optional. Empty disables the /manus-storage redirect route. Only expose truly public prefixes.
PUBLIC_STORAGE_PREFIXES=public/

# Required only when the restricted public storage proxy is enabled.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
